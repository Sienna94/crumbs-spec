{
  "name": "crumbs-spec",
  "version": "0.2.0",
  "description": "Living specs for coding agents: one owner per policy, a machine-checked link graph, and skills that write, find, ask and ingest.",
  "keywords": [
    "spec",
    "specification",
    "living-documentation",
    "coding-agents",
    "claude-code",
    "codex",
    "agent-skills",
    "markdown",
    "lint",
    "link-graph",
    "llm-wiki"
  ],
  "author": "sienna <siennachang.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sienna94/crumbs-spec.git"
  },
  "homepage": "https://github.com/Sienna94/crumbs-spec#readme",
  "bugs": {
    "url": "https://github.com/Sienna94/crumbs-spec/issues"
  },
  "type": "module",
  "bin": {
    "crumbs": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "postbuild": "node -e \"require('fs').chmodSync('dist/src/cli.js', 0o755)\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}
