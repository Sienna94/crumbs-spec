{
  "name": "crumbs-spec",
  "version": "0.1.0",
  "description": "Living, responsibility-owned spec docs for AI coding agents, connected as a verified link graph.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crumbs": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
